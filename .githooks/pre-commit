#!/usr/bin/env bash
# ==============================================================================
# Git 预提交代码质量与主干底座版本防呆钩子 (Pre-commit Hook)
#
# 1. dev 与特性分支放行本地 yalc 联调提交；仅在 main / release/* 分支拦截
#    包含 file:.yalc / file:../ / link: / 本地 .tgz 的 package.json 或 pnpm-lock.yaml；
# 2. 在存在 package.json 且已安装依赖时，优先运行 lint-staged 或 typecheck + lint。
#
# @author Ateng
# @since 2026-11-18
# ==============================================================================

set -eo pipefail

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
if [ "$CURRENT_BRANCH" = "main" ] || [[ "$CURRENT_BRANCH" =~ ^release/ ]]; then
  TRACKED_MANIFESTS=$(git ls-files 'package.json' 'pnpm-lock.yaml' '*/package.json' '*/pnpm-lock.yaml' || true)
  if [ -n "$TRACKED_MANIFESTS" ]; then
    while IFS= read -r manifest; do
      [ -n "$manifest" ] || continue
      git cat-file -e ":$manifest" 2>/dev/null || continue
      if git show ":$manifest" | grep -Eq 'file:\.yalc/|file:\.\./|link:|yalc:|file:.*\.tgz'; then
        printf "\n[ERROR] 检测到 %s 分支暂存区 %s 包含未清理的本地联调依赖（yalc / link / file:../ / .tgz）！\n" "$CURRENT_BRANCH" "$manifest" >&2
        printf "请先等待底座正式发版后执行还原：yalc remove --all && pnpm up @atengk/*\n\n" >&2
        exit 1
      fi
    done <<< "$TRACKED_MANIFESTS"
  fi
fi

if [ ! -f package.json ] || [ ! -d node_modules ]; then
  echo "ℹ️ [pre-commit] 尚未初始化前端依赖，跳过静态预检。"
  exit 0
fi

if ! command -v pnpm >/dev/null 2>&1; then
  echo "⚠️ [pre-commit] 未检测到 pnpm，跳过本地预提交检查。"
  exit 0
fi

if node -e "const p=require('./package.json'); process.exit((p.devDependencies&&p.devDependencies['lint-staged'])||p['lint-staged']?0:1)" 2>/dev/null; then
  pnpm exec lint-staged
else
  if node -e "const s=(require('./package.json').scripts||{}); process.exit(s.typecheck?0:1)" 2>/dev/null; then
    pnpm run typecheck
  fi
  if node -e "const s=(require('./package.json').scripts||{}); process.exit(s.lint?0:1)" 2>/dev/null; then
    pnpm run lint
  fi
fi
