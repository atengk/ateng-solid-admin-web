{
  "name": "ateng-solid-admin-web",
  "version": "0.1.0",
  "private": true,
  "description": "ateng-solid 企业级多租户管理后台 Web 前端工程 (Vue 3.5 + Vite 6 + ateng-ui + TailwindCSS v4 无 Preflight)",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:force": "vite --force",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@atengk/core": "^1.0.0",
    "@atengk/element-plus": "^1.0.0",
    "@atengk/vue": "^1.0.0",
    "@element-plus/icons-vue": "^2.3.1",
    "element-plus": "^2.14.7",
    "pinia": "^3.0.0",
    "vue": "^3.5.44",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.30.0",
    "globals": "^15.11.0",
    "happy-dom": "^15.11.7",
    "prettier": "^3.3.3",
    "sass": "^1.106.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.0"
  }
}
