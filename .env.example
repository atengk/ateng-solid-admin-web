# 应用显示标题
VITE_APP_TITLE=ateng-solid 管理后台

# 本地开发端口
VITE_PORT=5173

# 接口请求基础地址（默认留空：开发期直通 /admin/** 经由 Vite Proxy 转发；生产独立网关域时填写外部基地址）
VITE_API_BASE_URL=

# 后端代理目标（本地联调可在 .env.local 覆盖为单体服务或网关地址）
VITE_PROXY_TARGET=http://127.0.0.1:8080

# 是否开启 @atengk/monitor 前端异常与性能监控（默认关闭）
VITE_MONITOR_ENABLED=false
VITE_MONITOR_DSN=
